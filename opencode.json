{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/SYSTEM_OVERVIEW.html",
    "docs/ARM_GEOMETRY.md",
    "docs/IMPLEMENTATION_LOG.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
