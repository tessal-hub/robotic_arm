{
  "name": "@electronics-agent-kit/kicad-api",
  "version": "0.1.0",
  "description": "TypeScript client for KiCad's Protobuf IPC API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
